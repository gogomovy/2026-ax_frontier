# ─────────────────────────────────────────────────────────────────────────────
# NH AI 경영 의사결정 플랫폼 — 환경 변수
#   `make env` 를 실행하면 .env 가 없을 때 이 파일을 복사하고,
#   비어 있는 비밀값(SESSION_SECRET · CONFIG_ENC_KEY · LITELLM_MASTER_KEY · 비밀번호)을 무작위로 채운다.
#   비밀값은 이미지에 포함되지 않으며 .env 는 저장소에 커밋하지 않는다(DEP-03).
# ─────────────────────────────────────────────────────────────────────────────

IMAGE_TAG=local
WEB_PORT=3000
API_PORT=8000
LITELLM_PORT=4000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# 업무 자료는 기동 · 시드가 넣지 않는다 — 관리자 [데이터셋 · 문서] 또는 업무 [자료 올리기]에서 직접 올린다(M.20 · Q206).
# 예전에 올린 자료를 비우려면 make backup → make reset-data → make reset-data YES=1
# 화면 기준일은 올라온 자료의 최신 기준일(관리자 [설정] ui.as_of 로 고정 가능)
# 시드는 플랫폼만(Phase O) — 업무 구조(지표 산식 · 규칙 · 기준값 · 조직 · 업무 흐름 · 화면 연결 · 정의서)는 관리자 [업무 구성]에
# 구성 파일(엑셀 · JSON)로 올린다. 구성은 원천을 자료 이름 · 필요한 열로 가리키고, 그 자료가 올라오면 자동으로 이어진다(없으면 '자료 대기').
# 데이터셋 정의(열 · 타입 · 키 · 기준일)는 올린 파일에서 만들어진다. 예전 SEED_DATASET_DEFS · SEED_COLUMN_CONTRACTS · SEED_CONTRACT_EXPECTED 는 읽지 않는다.

# ── 저장소 ───────────────────────────────────────────────────
POSTGRES_USER=nhdip
POSTGRES_DB=nhdip
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
# API 전용 DB 계정 비밀번호 — api 는 데이터 조작만 가능한 계정(nhdip_app)으로 접속한다. 비우면 소유자 계정 사용
APP_DB_PASSWORD=

# ── 보안 ─────────────────────────────────────────────────────
# 세션 쿠키 서명 키 (32바이트 이상 무작위)
SESSION_SECRET=
# 관리자 화면에 저장하는 LLM 키 등을 암호화하는 마스터 키 (base64 32바이트)
CONFIG_ENC_KEY=
# HTTPS 환경이면 1 (쿠키 Secure 플래그 + HSTS)
COOKIE_SECURE=0
# 변경 요청(POST 등) Origin 허용 목록(쉼표, 예: https://nhdip.example). 비우면 같은 출처만 허용
TRUSTED_ORIGINS=
# 사용자 IP 판정 — X-Forwarded-For 를 믿을 바로 앞 프록시(CIDR 또는 이름, 기본 web 컨테이너)와 프록시 겹 수
# 앞에 사내 L7 프록시가 하나 더 있으면 TRUSTED_PROXY_HOPS=2
TRUSTED_PROXIES=127.0.0.1/32,::1/128,web
TRUSTED_PROXY_HOPS=1
# 앞에 사내 L7 프록시가 있으면 1 — 그 프록시가 채운 X-Forwarded-For 를 web 이 그대로 넘긴다(기본 0: 사용자가 보낸 값은 지움)
TRUST_UPSTREAM_PROXY=0
# API 문서(/docs) — 운영(prod)은 기본 꺼짐. true 로 켠다
API_DOCS=
# 포트 공개 범위 — 웹은 기본 전체, 관리용(API · LiteLLM · Neo4j)은 이 컴퓨터에서만. 외부 공개는 0.0.0.0
WEB_BIND=0.0.0.0
ADMIN_BIND=127.0.0.1
# 업무 시간대 (화면 날짜 · 로그)
TZ=Asia/Seoul
# 트랜잭션 유휴 제한(ms) — 잠금을 쥔 채 멈춘 연결을 DB 가 끊는다. 0 = 끄기
DB_IDLE_TX_TIMEOUT_MS=600000

# ── 최초 관리자 (AUTH-10) ────────────────────────────────────
BOOTSTRAP_ADMIN_EMP_NO=00000001
BOOTSTRAP_ADMIN_PASSWORD=
# 시연용 사용자 3명(20250001 종합기획부 · 20250002 신용리스크관리부 · 20250003 영업점) 비밀번호. 비우면 만들지 않음
DEMO_USER_PASSWORD=

# ── LLM (외부 LiteLLM) ───────────────────────────────────────
# 기본: 외부(사내) LiteLLM 의 주소 · 키 · 모델을 관리자 화면 [LLM 연동] → '간단 설정' 에서 입력한다(재기동 불필요).
# 아래 LLM_DEFAULT_* 를 채워 두면 최초 시드 때 그 값으로 등록된다.
#
# ── (선택) 내장 LiteLLM 게이트웨이 ─────────────────────────────
# 외부 LiteLLM 이 없을 때만 — COMPOSE_PROFILES=litellm 으로 켜고, 관리자 화면 주소에 http://litellm:4000 입력
# COMPOSE_PROFILES=litellm
# 게이트웨이 마스터 키 — http://localhost:4000/ui 로그인, 가상 키 발급에 사용
LITELLM_MASTER_KEY=
LITELLM_UI_PASSWORD=
# 이미지는 docker-compose.yml 에 digest 로 고정되어 있다. 올릴 때만 지정 (PG_IMAGE · NEO4J_IMAGE 도 같음)
# LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable

# 최초 시드 시 [관리자 > LLM 연동] 기본 연결로 등록할 값 (비워 두면 화면에서 입력) — 예: https://litellm.example.com
LLM_DEFAULT_BASE_URL=
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=coder.general.multimodal
# ── 업로드 보안 (선택) ─────────────────────────────────────
# 외부 백신 명령. {path} 자리에 검사할 파일 경로가 들어간다. 비우면 내장 검사(형식 · 압축 폭탄 · 매크로 · PDF 스크립트 · DRM)만
UPLOAD_AV_COMMAND=
# ── SSO (선택 · OIDC Authorization Code + PKCE) ───────────────
# 비우면 꺼짐. 리디렉션 주소는 웹 주소 기준: https://<웹 주소>/backend/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# 사번(8자리)이 담긴 ID 토큰 클레임
OIDC_EMP_CLAIM=emp_no
# 사번 · 비밀번호 로그인 허용: all(기본) · admin(관리자 비상 로그인만) · none
OIDC_LOCAL_LOGIN=all
# ── 운영 알림 (선택) ───────────────────────────────────────
# 비우면 알림은 기록만 합니다. 켜기 · 조건은 관리자 [운영 알림 · 비용] 설정(alerts.policy)
ALERT_WEBHOOK_URL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=25
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
# 받는 사람(쉼표)
ALERT_SMTP_TO=
ALERT_SMTP_STARTTLS=1
# ── 검색 엔진: Elasticsearch (3-way 구성 · 설계 §24) ───────────────────
# 3-way = PostgreSQL(원장 · 권한 · 임베딩 값) + Elasticsearch(키워드 BM25 + nori · 의미 kNN — 분석 결과 · 문서 색인) + Neo4j(개념 그래프).
# docker compose 기본 서비스 elasticsearch(nori 포함 이미지)를 쓴다. 외부(사내) ES 를 쓰면 ES_URL · ES_USER · ES_PASSWORD 를 그쪽으로.
# 워커가 1분마다 PostgreSQL → ES 로 동기화하고, ES 가 없거나 안 되면 검색은 자동으로 PostgreSQL 로 축소 동작한다(운영 점검 search_backend 가 경고).
# ES 를 아예 쓰지 않으려면 ES_URL= 로 비우고 검색 설정 knowledge.search.backend 를 "pg" 로.
# 호스트에 vm.max_map_count=262144 이상(sysctl)이 필요하다 — make host-check (infra/scripts/check-host.sh)가 확인한다
ES_URL=http://elasticsearch:9200
ES_USER=elastic
# 비워 두면 make env 가 만든다(내장 ES 의 elastic 계정 비밀번호)
ES_PASSWORD=
ES_INDEX=nhdip-kb-chunk
ES_DOC_INDEX=nhdip-doc-chunk
# https 의 ES 가 사내(사설) 인증서면 검증을 끄지(0) 말고 CA 파일 경로를 넣는다 — 컨테이너 안에서 읽을 수 있는 경로(볼륨으로 마운트)
ES_VERIFY_CERTS=1
ES_CA_CERTS=
# ES_HEAP=1g
