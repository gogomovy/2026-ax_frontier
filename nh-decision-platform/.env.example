# ─────────────────────────────────────────────────────────────────────────────
# NH AI 경영 의사결정 플랫폼 — 환경 변수
#   `make env` 를 실행하면 .env 가 없을 때 이 파일을 복사하고,
#   비어 있는 비밀값(SESSION_SECRET · CONFIG_ENC_KEY · LITELLM_MASTER_KEY · 비밀번호)을 무작위로 채운다.
#   비밀값은 이미지에 포함되지 않으며 .env 는 저장소에 커밋하지 않는다(DEP-03).
# ─────────────────────────────────────────────────────────────────────────────

IMAGE_TAG=local
WEB_PORT=3000
API_PORT=8000
LITELLM_PORT=4000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# 분석 기준일 (목데이터 시나리오 기준)
AS_OF_DEFAULT=2026-08-31

# ── 저장소 ───────────────────────────────────────────────────
POSTGRES_USER=nhdip
POSTGRES_DB=nhdip
POSTGRES_PASSWORD=
NEO4J_PASSWORD=

# ── 보안 ─────────────────────────────────────────────────────
# 세션 쿠키 서명 키 (32바이트 이상 무작위)
SESSION_SECRET=
# 관리자 화면에 저장하는 LLM 키 등을 암호화하는 마스터 키 (base64 32바이트)
CONFIG_ENC_KEY=
# HTTPS 환경이면 1 (쿠키 Secure 플래그 + HSTS)
COOKIE_SECURE=0
# 변경 요청(POST 등) Origin 허용 목록(쉼표, 예: https://nhdip.example). 비우면 같은 출처만 허용
TRUSTED_ORIGINS=
# API 문서(/docs) — 운영(prod)은 기본 꺼짐. true 로 켠다
API_DOCS=
# 포트 공개 범위 — 웹은 기본 전체, 관리용(API · LiteLLM · Neo4j)은 이 컴퓨터에서만. 외부 공개는 0.0.0.0
WEB_BIND=0.0.0.0
ADMIN_BIND=127.0.0.1
# 업무 시간대 (화면 날짜 · 로그)
TZ=Asia/Seoul
# 트랜잭션 유휴 제한(ms) — 잠금을 쥔 채 멈춘 연결을 DB 가 끊는다. 0 = 끄기
DB_IDLE_TX_TIMEOUT_MS=600000

# ── 최초 관리자 (AUTH-10) ────────────────────────────────────
BOOTSTRAP_ADMIN_EMP_NO=00000001
BOOTSTRAP_ADMIN_PASSWORD=
# 시연용 사용자 3명(20250001 종합기획부 · 20250002 신용리스크관리부 · 20250003 영업점) 비밀번호. 비우면 만들지 않음
DEMO_USER_PASSWORD=

# ── LiteLLM 게이트웨이 ───────────────────────────────────────
# 게이트웨이 마스터 키 — http://localhost:4000/ui 로그인, 가상 키 발급에 사용
LITELLM_MASTER_KEY=
LITELLM_UI_PASSWORD=
# 이미지는 docker-compose.yml 에 digest 로 고정되어 있다. 올릴 때만 지정 (PG_IMAGE · NEO4J_IMAGE 도 같음)
# LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable

# 최초 시드 시 [관리자 > LLM 연동] 기본 연결로 등록할 값 (비워 두면 화면에서 입력)
LLM_DEFAULT_BASE_URL=http://litellm:4000
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_MODEL=coder.general.multimodal
# ── 업로드 보안 (선택) ─────────────────────────────────────
# 외부 백신 명령. {path} 자리에 검사할 파일 경로가 들어간다. 비우면 내장 검사(형식 · 압축 폭탄 · 매크로 · PDF 스크립트 · DRM)만
UPLOAD_AV_COMMAND=
# ── SSO (선택 · OIDC Authorization Code + PKCE) ───────────────
# 비우면 꺼짐. 리디렉션 주소는 웹 주소 기준: https://<웹 주소>/backend/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# 사번(8자리)이 담긴 ID 토큰 클레임
OIDC_EMP_CLAIM=emp_no
# 사번 · 비밀번호 로그인 허용: all(기본) · admin(관리자 비상 로그인만) · none
OIDC_LOCAL_LOGIN=all
# ── 운영 알림 (선택) ───────────────────────────────────────
# 비우면 알림은 기록만 합니다. 켜기 · 조건은 관리자 [운영 알림 · 비용] 설정(alerts.policy)
ALERT_WEBHOOK_URL=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=25
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
# 받는 사람(쉼표)
ALERT_SMTP_TO=
ALERT_SMTP_STARTTLS=1
